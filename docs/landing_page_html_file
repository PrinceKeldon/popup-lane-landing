<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>PopUp Lane — Black Friday '25</title>
<meta name="description" content="PopUp Lane — the digital lane that opens for moments and puts small brands in the spotlight. Discover limited-time indie drops and support creators.">
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🖤</text></svg>">

<!-- Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">

<style>
/* ===========================
   Design 2 — Charcoal + White
   =========================== */
:root{
  --bg:#f8f8f8;            /* off-white page background */
  --card:#ffffff;          /* card backgrounds */
  --charcoal:#111111;      /* primary text / accents */
  --muted:#6b6f76;         /* secondary text */
  --open-overlay: rgba(250,245,240,0.18); /* warm, subtle overlay when live */
  --glass: rgba(17,18,23,0.06);
}

/* Reset & base */
*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0;
  font-family:"Inter",system-ui,-apple-system,Segoe UI,Roboto,"Helvetica Neue",Arial;
  background:var(--bg);
  color:var(--charcoal);
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
  line-height:1.45;
  opacity:0; transform:translateY(6px);
  animation:pageFade .45s ease forwards;
}
@keyframes pageFade{ to{ opacity:1; transform:none } }

.wrap{max-width:1100px;margin:0 auto;padding:48px 20px 96px;}

/* HERO */
.hero{
  padding:48px 0 28px;text-align:center; position:relative; transition:transform .45s cubic-bezier(.2,.9,.3,1), background-color .45s ease; will-change:transform, background-color;
}
.eyebrow{font-size:13px;color:var(--muted);letter-spacing:1.6px;text-transform:uppercase;margin-bottom:14px}
.title{
  font-family:"Playfair Display",serif;
  font-weight:700;
  font-size:clamp(34px,6.2vw,64px);
  line-height:1.02;
  margin:0 auto 12px;
}
.title .season{display:block;font-size:0.36em;color:var(--muted);letter-spacing:4px;margin-bottom:10px}
.subtitle{max-width:760px;margin:0 auto;color:var(--muted);font-size:18px;transition:opacity .45s ease}

/* Live pill (above CTAs) */
.live-pill {
  display:inline-block;
  margin-top:14px;
  padding:8px 14px;
  border-radius:999px;
  background:linear-gradient(90deg, rgba(255,255,255,0.9), rgba(250,245,240,0.7));
  color:var(--charcoal);
  font-weight:600;
  font-size:13px;
  opacity:0;
  transform:translateY(-6px);
  transition:opacity .45s ease, transform .45s ease;
  box-shadow:0 8px 30px rgba(17,18,23,0.04);
}
.hero.open .live-pill{ opacity:1; transform:translateY(0); }

/* Countdown */
.countdown{display:flex;gap:18px;justify-content:center;align-items:end;margin:28px 0 20px;font-family:Inter,monospace}
.countseg{display:flex;flex-direction:column;align-items:center;min-width:72px}
.countnum{font-weight:700;font-size:30px;color:var(--charcoal);background:#fff;padding:8px 18px;border-radius:8px;border:1px solid rgba(17,18,23,0.06);box-shadow:0 6px 20px rgba(17,18,23,0.04);transition:opacity .35s ease}
.countlabel{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-top:8px}
.hero.open .countnum{ opacity:0.85; }

/* CTAs */
.ctas{display:flex;gap:12px;justify-content:center;margin-top:18px;flex-wrap:wrap}
.btn{display:inline-block;padding:12px 20px;border-radius:10px;text-decoration:none;font-weight:600}
.btn.primary{background:var(--charcoal);color:#fff;box-shadow:0 8px 28px rgba(17,18,23,0.08);transition:background .25s ease}
.btn.ghost{background:transparent;color:var(--charcoal);border:1px solid rgba(17,18,23,0.08);transition:background .25s ease,color .25s ease}
.btn.primary:focus, .btn.ghost:focus { outline:3px solid rgba(17,18,23,0.06); outline-offset:3px; }

/* HOW IT WORKS */
.how{margin:64px 0}
.how h2{font-family:"Playfair Display",serif;font-size:28px;margin:0 0 20px;text-align:center}
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.step{background:var(--card);border-radius:12px;padding:20px;border:1px solid rgba(17,18,23,0.04);box-shadow:0 6px 18px rgba(17,18,23,0.03);transition:transform .3s ease,box-shadow .3s ease}
.step:hover{transform:translateY(-5px);box-shadow:0 10px 30px rgba(17,18,23,0.05)}
.step .num{font-weight:700;color:var(--charcoal);font-size:20px;margin-bottom:8px}
.step h3{margin:0 0 8px;font-size:16px}
.step p{margin:0;color:var(--muted);font-size:14px}

/* ABOUT */
.about{margin:48px 0 24px;text-align:center;max-width:880px;margin-left:auto;margin-right:auto}
.about h3{font-family:"Playfair Display",serif;margin:0 0 8px;font-size:20px}
.about p{color:var(--muted);font-size:15px;margin:0 auto;max-width:760px;line-height:1.6}

/* NOTIFY */
.notify{margin:64px 0;padding:34px;border-radius:12px;background:linear-gradient(180deg,#ffffff,#fbfbfb);border:1px solid rgba(17,18,23,0.03);display:flex;align-items:center;gap:24px;justify-content:space-between}
.notify .left{max-width:68%}
.notify h3{margin:0 0 6px;font-family:"Playfair Display",serif;font-size:20px}
.notify p{margin:0;color:var(--muted);font-size:14px}
.notify form{display:flex;gap:10px;align-items:center}
.notify input[type="email"]{padding:12px 14px;border-radius:10px;border:1px solid rgba(17,18,23,0.06);min-width:240px}
.notify button{padding:12px 16px;border-radius:10px;border:none;background:var(--charcoal);color:#fff;font-weight:600}

/* MEMORY carousel */
.memory{margin:64px 0}
.memory h4{text-transform:uppercase;color:var(--muted);letter-spacing:1.6px;font-size:12px;margin:0 0 18px;text-align:left}
.memory .memory-wrap{position:relative;overflow:hidden;border-radius:12px;padding:18px;background:linear-gradient(180deg, rgba(17,18,23,0.01), rgba(17,18,23,0.01));border:1px solid rgba(17,18,23,0.03)}
.track{display:flex;gap:16px;align-items:center;will-change:transform}
.brand{
  flex:0 0 180px;
  height:80px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:12px;
  background:linear-gradient(180deg, rgba(255,255,255,0.6), rgba(255,255,255,0.5));
  box-shadow:0 6px 18px rgba(17,18,23,0.04);
  border:1px solid rgba(17,18,23,0.06);
  backdrop-filter: blur(6px);
  padding:12px;
}
.brand img{max-width:140px;max-height:56px;object-fit:contain;opacity:0.95;filter:grayscale(0.15)}
.memory-mask{mask-image:linear-gradient(90deg,transparent 0%, black 8%, black 92%, transparent 100%);-webkit-mask-image:linear-gradient(90deg,transparent 0%, black 8%, black 92%, transparent 100%);}

/* Footer */
footer{margin-top:60px;padding:28px 0;text-align:center;color:var(--muted);font-size:13px;border-top:1px solid rgba(17,18,23,0.03)}
.footer-links{margin-top:8px;font-size:13px;color:var(--muted)}
.footer-links a{color:var(--muted);text-decoration:none;margin:0 8px}

/* Responsive */
@media (max-width:900px){
  .steps{grid-template-columns:1fr;}
  .notify{flex-direction:column;align-items:stretch}
  .notify .left{max-width:100%}
}

/* Open hero transform */
.hero.open{ transform: translateY(-10px); background-color:var(--open-overlay); }
.hero.closed-subtle .subtitle{ opacity:0.9; }

/* visually hidden helper: screen reader announcements */
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
</style>
</head>
<body>
  <div class="wrap">

    <!-- ARIA announcer for live state updates (screen readers) -->
    <div id="aria-announcer" class="sr-only" aria-live="polite" aria-atomic="true"></div>

    <!-- HERO -->
    <header id="hero" class="hero" role="banner" aria-labelledby="page-title">
      <!-- eyebrow (populated by config) -->
      <div class="eyebrow" id="eyebrow">Black Friday Pop-Up</div>

      <!-- Title (season name from config) -->
      <h1 id="page-title" class="title"><span class="season" id="season-small">BLACK FRIDAY '25</span>PopUp Lane</h1>

      <!-- Voice-aligned subtitle -->
      <p id="subtitle" class="subtitle">
        The Lane opens soon — where small brands take the spotlight. Great products. Limited time. No algorithms, no chaos — just creators getting the attention they deserve.
      </p>

      <!-- "We're Live" pill above CTAs (appears when open) -->
      <div id="live-pill" class="live-pill" aria-hidden="true">We're Live!</div>

      <!-- Countdown -->
      <div class="countdown" role="timer" aria-live="polite" aria-atomic="true" aria-label="Time until next pop up">
        <div class="countseg"><div class="countnum" id="days">00</div><div class="countlabel">Days</div></div>
        <div class="countseg"><div class="countnum" id="hours">00</div><div class="countlabel">Hrs</div></div>
        <div class="countseg"><div class="countnum" id="mins">00</div><div class="countlabel">Min</div></div>
        <div class="countseg"><div class="countnum" id="secs">00</div><div class="countlabel">Sec</div></div>
      </div>

      <!-- CTAs (primary changes to "Shop Now" when live) -->
      <div class="ctas" role="navigation" aria-label="Primary actions">
        <a id="primary-cta" class="btn primary" href="#explore">Walk the Lane</a>
        <a id="secondary-cta" class="btn ghost" href="#list">List Your Brand</a>
      </div>
    </header>

    <!-- HOW IT WORKS -->
    <section class="how" id="how-it-works" aria-labelledby="how-title">
      <h2 id="how-title">How It Works</h2>
      <div class="steps" role="list">
        <div class="step" role="listitem">
          <div class="num">01</div>
          <h3>We Open the Lane</h3>
          <p>Each season PopUp Lane opens its digital street for a limited time, creating a curated moment of discovery.</p>
        </div>

        <div class="step" role="listitem">
          <div class="num">02</div>
          <h3>Small Brands Take the Spotlight</h3>
          <p>We highlight makers and merchants so great products don't get buried by algorithms or ad spend.</p>
        </div>

        <div class="step" role="listitem">
          <div class="num">03</div>
          <h3>You Find What Matters</h3>
          <p>Shop intentionally: limited-time items, real stories, and deals that reward discovery — not noise.</p>
        </div>
      </div>
    </section>

    <!-- ABOUT (new, voice-aligned) -->
    <section class="about" aria-labelledby="about-title">
      <h3 id="about-title">What is PopUp Lane?</h3>
      <p>
        PopUp Lane is a seasonal digital pop-up — a curated directory that opens during major shopping moments (Black Friday, the holidays, and more).
        We spotlight independent brands and make them impossible to scroll past. While the Lane is open, shoppers can browse filtered collections and visit each merchant's storefront to purchase directly.
      </p>
      <p style="margin-top:10px">
        Importantly, merchants <strong>keep 100% of every sale</strong>. Transactions happen on the merchant's own site or platform (Shopify, Etsy, native checkout, etc.). PopUp Lane generates revenue through placement fees, sponsorships, and optional affiliate partnerships when brands opt in — never by taking a cut of a creator's sales.
      </p>
    </section>

    <!-- NOTIFY (Lovable-ready) -->
    <section class="notify" aria-labelledby="notify-title">
      <div class="left">
        <h3 id="notify-title">Be First in the Lane — Shoppers & Small Brands Welcome</h3>
        <p>Sign up for early access! Shoppers get first pick of limited-time indie deals, and merchants secure exclusive visibility for the next PopUp Lane.</p>
        <p style="font-size:13px; color:var(--muted); margin-top:6px;">
          Merchants: List your brand and be featured during the season — no upfront sales required, just exposure.
        </p>
      </div>

      <!-- Lovable-ready form: data-lovable-form attribute for future connection -->
      <form id="notify-form" data-lovable-form="notify-list" data-lovable-redirect="/thank-you" aria-label="Notify form">
        <input type="email" id="notify-email" name="email" placeholder="you@domain.com" aria-label="Email address" required>
        <button type="submit" aria-label="Notify me">Join the Lane</button>
      </form>
    </section>

    <!-- MEMORY / BRAND CAROUSEL -->
    <section class="memory" aria-labelledby="memory-title">
      <h4 id="memory-title">Brands That Made Last Season</h4>
      <div class="memory-wrap memory-mask" aria-hidden="false">
        <div class="track" id="track" aria-hidden="false"></div>
      </div>
    </section>

    <footer>
      © <span id="year">2025</span> PopUp Lane — A digital lane that opens for moments, and remembers the brands that made them.
      <div class="footer-links" aria-hidden="false">
        <a href="#terms">Terms</a> · <a href="#privacy">Privacy</a>
      </div>
    </footer>
  </div>

<script>
/* =====================================================
   POPUP_CONFIG
   — single source of truth for season name, dates, brands
   — edit this block to update each season (no other changes needed)
   ===================================================== */
const POPUP_CONFIG = {
  season: {
    name: "BLACK FRIDAY '25",
    eyebrow: "Black Friday Pop-Up",
    // ISO datetimes (local time). Replace with new dates for future seasons.
    openDate: "2025-11-21T10:00:00",
    closeDate: "2025-11-28T23:59:59"
  },

  motion: {
    // Carousel speed (px per second) for the brand memory carousel
    carouselSpeed: 30
  },

  notify: {
    // Lovable form name (data-lovable-form) and redirect
    formName: "notify-list",
    redirect: "/thank-you",
    placeholder: "you@domain.com"
  },

  // Brands that made last season: update these with real logo URLs & names
  brands: [
    { name: "Loom & Found", img: "https://placehold.co/140x56/ffffff/111?text=Loom+%26+Found" },
    { name: "Bright Studio", img: "https://placehold.co/140x56/ffffff/111?text=Bright+Studio" },
    { name: "Thread Theory", img: "https://placehold.co/140x56/ffffff/111?text=Thread+Theory" },
    { name: "Indie Flame", img: "https://placehold.co/140x56/ffffff/111?text=Indie+Flame" },
    { name: "Velvet Arc", img: "https://placehold.co/140x56/ffffff/111?text=Velvet+Arc" },
    { name: "Echo Haus", img: "https://placehold.co/140x56/ffffff/111?text=Echo+Haus" }
  ]
};

/* =====================================================
   Utility helpers
   ===================================================== */
function el(id){ return document.getElementById(id); }
function pad(n){ return String(n).padStart(2,'0'); }

/* =====================================================
   Init: populate UI from POPUP_CONFIG (titles, form attributes, brands)
   ===================================================== */
(function initFromConfig(){
  // populate eyebrow and season
  el('eyebrow').textContent = POPUP_CONFIG.season.eyebrow || 'Seasonal Pop-Up';
  el('season-small').textContent = POPUP_CONFIG.season.name || 'SEASON';
  el('page-title') && (document.title = `${POPUP_CONFIG.season.name} — PopUp Lane`);

  // configure Lovable-ready form attributes
  const notifyForm = el('notify-form');
  if(notifyForm && POPUP_CONFIG.notify){
    notifyForm.setAttribute('data-lovable-form', POPUP_CONFIG.notify.formName);
    if(POPUP_CONFIG.notify.redirect) notifyForm.setAttribute('data-lovable-redirect', POPUP_CONFIG.notify.redirect);
    const emailInput = el('notify-email');
    if(emailInput && POPUP_CONFIG.notify.placeholder) emailInput.placeholder = POPUP_CONFIG.notify.placeholder;
  }

  // populate brand carousel (.track) and duplicate for seamless scroll
  const track = el('track');
  if(track && Array.isArray(POPUP_CONFIG.brands)){
    function makeBrandNode(b){
      const div = document.createElement('div');
      div.className = 'brand';
      const img = document.createElement('img');
      img.src = b.img;
      img.alt = b.name + ' logo';
      div.appendChild(img);
      return div;
    }
    const frag = document.createDocumentFragment();
    POPUP_CONFIG.brands.forEach(b => frag.appendChild(makeBrandNode(b)));
    POPUP_CONFIG.brands.forEach(b => frag.appendChild(makeBrandNode(b))); // duplicate set
    track.appendChild(frag);
  }

  // set current year in footer
  el('year').textContent = new Date().getFullYear();
})();

/* =====================================================
   Countdown + Hero state transitions
   - uses POPUP_CONFIG.season.openDate and closeDate
   - states: before -> live -> after
   - announces changes via aria for accessibility
   ===================================================== */
(function countdownAndHero(){
  const openDate = new Date(POPUP_CONFIG.season.openDate);
  const closeDate = new Date(POPUP_CONFIG.season.closeDate);

  const daysEl = el('days'), hoursEl = el('hours'), minsEl = el('mins'), secsEl = el('secs');
  const hero = el('hero'), livePill = el('live-pill'), subtitle = el('subtitle'), primaryCta = el('primary-cta');
  const ariaAnnouncer = el('aria-announcer');

  function announce(msg){ if(ariaAnnouncer) ariaAnnouncer.textContent = msg; }

  function setHeroState(state){
    hero.classList.remove('open','closed-subtle','animated');
    livePill.setAttribute('aria-hidden','true');

    if(state === 'before'){
      subtitle.textContent = "The Lane opens soon — where small brands take the spotlight. Great products. Limited time. No algorithms, no chaos — just creators getting the attention they deserve.";
      primaryCta.textContent = "Walk the Lane";
      primaryCta.href = "#explore";
      announce("PopUp Lane opens soon. Join the waitlist to be first.");
      hero.classList.add('animated');
    } else if(state === 'live'){
      hero.classList.add('open','animated');
      livePill.setAttribute('aria-hidden','false');
      subtitle.textContent = "We're live — the Lane is open. Discover limited-time drops from indie makers while the pop-up is active.";
      primaryCta.textContent = "Shop Now";
      primaryCta.href = "#shop";
      announce("PopUp Lane is live. Shop now for limited-time deals from indie brands.");
    } else {
      hero.classList.add('closed-subtle','animated');
      livePill.setAttribute('aria-hidden','true');
      subtitle.textContent = "The Lane has closed — but we'll be back. Join the list to be first next season.";
      primaryCta.textContent = "Notify Me";
      primaryCta.href = "#notify";
      announce("PopUp Lane has closed for this season. Join the waitlist for the next pop-up.");
    }
  }

  function tick(){
    const now = new Date();
    let state = 'before', target = openDate;

    if(now >= closeDate){
      state = 'after';
      target = closeDate;
    } else if(now >= openDate){
      state = 'live';
      target = closeDate;
    }

    setHeroState(state);

    // calculate time diff
    const diff = Math.max(0, target - now);
    const d = Math.floor(diff/86400000);
    const h = Math.floor((diff%86400000)/3600000);
    const m = Math.floor((diff%3600000)/60000);
    const s = Math.floor((diff%60000)/1000);

    daysEl.textContent = pad(d);
    hoursEl.textContent = pad(h);
    minsEl.textContent = pad(m);
    secsEl.textContent = pad(s);
  }

  tick();
  setInterval(tick, 1000);
})();

/* =====================================================
   Memory carousel (auto-scroll)
   ===================================================== */
(function memoryCarousel(){
  const track = el('track');
  if(!track || !track.children.length) return;

  let offset = 0;
  const speed = POPUP_CONFIG.motion.carouselSpeed || 30; // px/sec
  let lastTime = performance.now();

  function animate(time){
    const delta = (time - lastTime) / 1000;
    lastTime = time;

    offset += speed * delta;

    // single set width
    const singleWidth = Array.from(track.children).slice(0, POPUP_CONFIG.brands.length).reduce((sum,el) => sum + el.offsetWidth + 16, 0);
    if(offset >= singleWidth) offset -= singleWidth;

    track.style.transform = `translateX(-${offset}px)`;
    requestAnimationFrame(animate);
  }

  requestAnimationFrame(animate);

  // recalc on resize
  window.addEventListener('resize', () => { offset = 0; });
})();

/* =====================================================
   Notify form stub (before Lovable integration)
   ===================================================== */
(function notifyStub(){
  const form = el('notify-form');
  if(!form) return;
  form.addEventListener('submit', e => {
    e.preventDefault();
    alert('Thanks for joining! (Lovable will handle this submission once integrated)');
  });
})();
</script>
</body>
