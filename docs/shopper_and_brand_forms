<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>PopUp Lane — Sign Up</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Playfair+Display:wght@600&display=swap" rel="stylesheet">

<style>
:root {
  --wine: #7b2b2b;
  --wine-light: #fbeaea;
  --text: #1a1a1a;
  --muted: #6b6f76;
  --card: #fff;
  --shadow: rgba(0,0,0,0.04);
}

* { box-sizing: border-box; }

body {
  font-family: 'Inter', sans-serif;
  background: #fafafa;
  color: var(--text);
  margin: 0;
  padding: 24px;
}

.container {
  max-width: 900px;
  margin: 0 auto;
}

.card {
  background: var(--card);
  border-radius: 14px;
  padding: 24px;
  box-shadow: 0 10px 25px var(--shadow);
  margin-bottom: 30px;
}

h2, h3 {
  font-family: 'Playfair Display', serif;
  margin-top: 0;
}

p {
  color: var(--muted);
}

input, select {
  width: 100%;
  padding: 12px 14px;
  border: 1px solid #ddd;
  border-radius: 8px;
  font-size: 15px;
}

button {
  background: var(--wine);
  color: #fff;
  border: none;
  padding: 12px 18px;
  border-radius: 10px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.25s ease;
  box-shadow: 0 3px 10px rgba(123,43,43,0.2);
}

button:hover {
  background: #922d2d;
  box-shadow: 0 6px 18px rgba(123,43,43,0.3);
  transform: translateY(-2px);
}

.form-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 10px;
}

.form-col {
  flex: 1;
  min-width: 200px;
}

.small {
  font-size: 13px;
  color: var(--muted);
  margin-top: 8px;
}

.merchant-section {
  background: var(--wine-light);
  border-left: 5px solid var(--wine);
  padding: 24px;
  border-radius: 14px;
}

.counter {
  margin-top: 8px;
  font-size: 14px;
  color: var(--wine);
  font-weight: 600;
}

footer {
  text-align: center;
  font-size: 13px;
  color: var(--muted);
  margin-top: 32px;
}

@media (max-width: 720px) {
  .form-row { flex-direction: column; }
}
</style>
</head>

<body>
<div class="container">

  <section class="card" id="shoppers">
    <h2>Be First in the Lane</h2>
    <p>Get notified when PopUp Lane opens — discover indie brands and special drops before the crowd.</p>
    <form id="shopperForm">
      <div class="form-row">
        <div class="form-col">
          <input type="email" name="email" placeholder="your email" required />
        </div>
        <div>
          <button type="submit">Get Notified</button>
        </div>
      </div>
      <div class="small">We’ll only email when something truly good drops — no spam.</div>
    </form>
  </section>

  <section class="card merchant-section" id="merchants">
    <h3>Merchant Early Access <span style="font-size:12px;background:var(--wine);color:#fff;padding:3px 6px;border-radius:4px;">AI-Assisted</span></h3>
    <p>Feature your store in the next PopUp Lane. Limited early access spots available.</p>
    <form id="merchantForm">
      <div class="form-row">
        <div class="form-col">
          <input type="email" name="email" placeholder="your email" required />
        </div>
        <div class="form-col">
          <input type="text" name="brand_name" placeholder="brand name (optional)" />
          <input type="url" name="website" placeholder="website url" style="margin-top:8px" />
          <input type="text" name="social" placeholder="social media handle or link" style="margin-top:8px" />
          <select name="category" style="margin-top:8px">
            <option value="">select category (optional)</option>
            <option>Fashion</option>
            <option>Home</option>
            <option>Beauty & Wellness</option>
            <option>Art & Lifestyle</option>
            <option>Other</option>
          </select>
        </div>
        <div>
          <button type="submit">Apply as Merchant</button>
        </div>
      </div>
      <div class="counter">Remaining spots: <span id="merchantCounter">...</span></div>
    </form>
  </section>

  <footer>
    © <span id="year"></span> PopUp Lane
  </footer>

</div>

<script>
const AIRTABLE_API = "YOUR_API_TOKEN";
const BASE_ID = "YOUR_BASE_ID";
const MERCHANTS_TABLE = "Merchants";
const SHOPPERS_TABLE = "Shoppers";

document.getElementById("year").textContent = new Date().getFullYear();

async function postToAirtable(table, data) {
  const response = await fetch(`https://api.airtable.com/v0/${BASE_ID}/${table}`, {
    method: "POST",
    headers: {
      Authorization: `Bearer ${AIRTABLE_API}`,
      "Content-Type": "application/json"
    },
    body: JSON.stringify({ fields: data })
  });
  return response.ok;
}

document.getElementById("shopperForm").addEventListener("submit", async (e) => {
  e.preventDefault();
  const email = e.target.email.value.trim();
  const ok = await postToAirtable(SHOPPERS_TABLE, { "Email Address": email, "Opt-in Confirmation": true });
  alert(ok ? "Thanks for joining the Lane!" : "Something went wrong — please try again.");
  e.target.reset();
});

document.getElementById("merchantForm").addEventListener("submit", async (e) => {
  e.preventDefault();
  const formData = Object.fromEntries(new FormData(e.target).entries());
  const ok = await postToAirtable(MERCHANTS_TABLE, {
    "Email Address": formData.email,
    "Brand Name": formData.brand_name || "",
    "Website": formData.website || "",
    "Social Media": formData.social || "",
    "Category": formData.category || "",
    "Status": "Pending"
  });
  alert(ok ? "Application received! We’ll be in touch soon." : "Submission failed — please try again.");
  e.target.reset();
  updateMerchantCount();
});

async function updateMerchantCount() {
  const res = await fetch(`https://api.airtable.com/v0/${BASE_ID}/${MERCHANTS_TABLE}?pageSize=100`, {
    headers: { Authorization: `Bearer ${AIRTABLE_API}` }
  });
  const data = await res.json();
  const total = data.records.length;
  const limit = 50; // Adjust number of total merchant spots
  const remaining = Math.max(limit - total, 0);
  document.getElementById("merchantCounter").textContent = `${remaining} of ${limit}`;
}

updateMerchantCount();
</script>
</body>
</html>

