<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>PopUp Lane – Pricing</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Playfair+Display:wght@600&display=swap" rel="stylesheet">

<style>
  :root {
    --bg:#f8f8f8;
    --card:#ffffff;
    --charcoal:#111;
    --muted:#6b6f76;
    --stroke:rgba(17,18,23,0.08);
    --wine:#6a0f1f;
  }

  body {
    margin:0; padding:0;
    background:var(--bg);
    font-family:Inter, sans-serif;
    color:var(--charcoal);
  }

  .wrap {
    max-width: 960px;
    margin: 0 auto;
    padding: 40px 20px 80px;
  }

  h1 {
    font-family: "Playfair Display", serif;
    text-align:center;
    font-size: 42px;
    margin-bottom: 10px;
  }

  .subtitle {
    text-align:center;
    max-width:640px;
    margin:0 auto 40px;
    color:var(--muted);
    font-size:16px;
  }

  .plans {
    display:grid;
    grid-template-columns:1fr;
    gap:32px;
  }

  @media (min-width:780px){
    .plans {
      grid-template-columns:1fr 1fr;
    }
  }

  .plan {
    background:var(--card);
    border:1px solid var(--stroke);
    border-radius:14px;
    padding:28px;
    box-shadow:0 10px 36px rgba(0,0,0,0.04);
  }

  .plan h2 {
    font-size:22px;
    margin:0 0 8px;
    font-family:"Playfair Display", serif;
  }

  .price {
    font-size:28px;
    font-weight:700;
    margin:8px 0 14px;
  }

  .desc {
    color:var(--muted);
    font-size:15px;
    margin-bottom:20px;
  }

  ul.features {
    margin:0; padding:0 0 0 20px;
    color:var(--charcoal);
    font-size:14px;
  }

  ul.features li {
    margin-bottom:8px;
  }

  .cta {
    margin-top:22px;
  }

  .btn {
    display:inline-block;
    padding:12px 18px;
    border-radius:10px;
    background:var(--charcoal);
    color:white;
    text-decoration:none;
    font-weight:600;
    transition:0.25s;
  }

  .btn:hover {
    background:#000;
  }

  .note {
    margin-top:10px;
    font-size:13px;
    color:var(--muted);
  }

  .badge {
    display:inline-block;
    background:var(--wine);
    color:white;
    padding:4px 10px;
    border-radius:6px;
    font-size:12px;
    margin-bottom:12px;
  }
</style>
</head>

<body>
<div class="wrap">

  <h1>PopUp Lane Pricing</h1>
  <p class="subtitle">
    Simple, flexible pricing designed for small brands.  
    Pay per Lane or join the Backroom to access year-round perks.
  </p>

  <div class="plans">

    <!-- LANE PASS -->
    <div class="plan">
      <span class="badge">Seasonal</span>
      <h2>Lane Pass</h2>
      <div class="price">$49.99</div>
      <p class="desc">Participate in a PopUp Lane for a single seasonal event.</p>
      <ul class="features">
        <li>Placement in the Lane for the full season</li>
        <li>Brand card + outbound shop link</li>
        <li>Deal highlighting & visibility boosts</li>
        <li>Shopper traffic routing</li>
        <li>Click + save analytics (MVP light)</li>
      </ul>

      <div class="cta">
        <a href="/checkout/lane-pass" class="btn">Join a Lane</a>
        <p class="note">One-time fee, valid for one Lane.</p>
      </div>
    </div>

    <!-- BACKROOM -->
    <div class="plan">
      <span class="badge">Most Popular</span>
      <h2>Backroom Membership</h2>
      <div class="price">$19.99/mo</div>
      <p class="desc">Your year-round home inside PopUp Lane. Community, early access & more.</p>
      <ul class="features">
        <li>Access to Lane Club community</li>
        <li>Merchant Notice Board posting</li>
        <li>Early access to upcoming Lanes</li>
        <li>Private merchant updates</li>
        <li>Feature previews & priority testing</li>
      </ul>

      <div class="cta">
        <a href="/checkout/backroom" class="btn">Join the Backroom</a>
        <p class="note">Cancel anytime. Lane Pass sold separately.</p>
      </div>
    </div>

  </div>

</div>
</body>
</html>
