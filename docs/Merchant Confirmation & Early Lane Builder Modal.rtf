\f0\fs24 \cf0 <!-- Merchant Confirmation & Early Lane Builder Modal -->\
<div id="merchant-confirmation-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.4); z-index:999; justify-content:center; align-items:center;">\
  <div style="background:#FAFAFA; border-radius:16px; padding:24px; max-width:480px; width:90%; text-align:center; box-shadow:0 12px 30px rgba(0,0,0,0.15); position:relative;">\
    \
    <!-- Close Button -->\
    <button id="close-modal" style="position:absolute; top:12px; right:12px; background:transparent; border:none; font-size:18px; cursor:pointer;">&times;</button>\
