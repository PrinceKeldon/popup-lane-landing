    <!-- Header -->\
    <h3 style="color:#800020; font-family:'Playfair Display', serif; margin-bottom:12px;">Welcome to the Early Lane, <span id="merchant-brand-name">Brand Name</span>!</h3>\
    \
    <!-- Email Confirmation -->\
    <p style="color:#111; margin-bottom:12px;">Confirmation sent to: <strong id="merchant-email-display">your@email.com</strong></p>\
\
    <!-- Countdown -->\
    <div style="margin-bottom:16px; font-family:Inter,monospace;">\
      <div>Lane opens in <span id="merchant-countdown-days">00</span> days</div>\
    </div>\
\
    <!-- Merchant Spots Remaining -->\
    <div style="margin-bottom:16px; font-weight:700; color:#800020;">Spots remaining: <span id="merchant-spots-remaining">50</span></div>\
\
