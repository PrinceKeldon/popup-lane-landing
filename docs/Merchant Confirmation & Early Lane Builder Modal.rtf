\
<script>\
// ====== Example JS: Show modal after form submission ======\
function showMerchantConfirmation(email, brandName, spotsRemaining) \{\
  const modal = document.getElementById('merchant-confirmation-modal');\
  const emailDisplay = document.getElementById('merchant-email-display');\
  const brandDisplay = document.getElementById('merchant-brand-name');\
  const spotsDisplay = document.getElementById('merchant-spots-remaining');\
\
  emailDisplay.textContent = email || 'your@email.com';\
  brandDisplay.textContent = brandName || 'Your Brand';\
  spotsDisplay.textContent = spotsRemaining || '50';\
\
  modal.style.display = 'flex';\
\
  // Countdown to early access date\
  const openDate = new Date("2025-11-17T10:00:00");\
  const daysEl = document.getElementById('merchant-countdown-days');\
  \
  function updateCountdown() \{\
    const now = new Date();\
    const diff = Math.max(0, openDate - now);\
    const days = Math.floor(diff / (1000*60*60*24));\
    daysEl.textContent = days;\
  \}\
  updateCountdown();\
  setInterval(updateCountdown, 1000);\
\}\
\
// Close modal logic\
document.getElementById('close-modal').addEventListener('click', () => \{\
  document.getElementById('merchant-confirmation-modal').style.display = 'none';\
\});\
\
// Example: call this after merchant form submission\
