    <button id="build-lane-btn" style="\
      background:#800020; color:#fff; padding:12px 20px; border:none; border-radius:12px; font-weight:700; font-size:16px; cursor:pointer; transition: all 0.25s ease;\
    " onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 8px 20px rgba(128,0,32,0.4)';" \
       onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 12px rgba(128,0,32,0.2)';">\
      Build Your Lane Listing\
    </button>\
  </div>\
